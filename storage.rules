rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public reads on all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to write (admin/branding uploads, user profile pics, etc)
    match /branding/{document=**} {
      allow write: if request.auth != null && 
                      request.auth.token.role == 'admin';
      allow read: if true;
    }

    match /custom_products/{document=**} {
      allow write: if request.auth != null && 
                      request.auth.token.role == 'admin';
      allow read: if true;
    }

    match /products/{document=**} {
      allow write: if request.auth != null && 
                      request.auth.token.role == 'admin';
      allow read: if true;
    }

    match /exhibition/{document=**} {
      allow write: if request.auth != null && 
                      request.auth.token.role == 'admin';
      allow read: if true;
    }

    // Default: any authenticated user can write to their own paths
    match /{userId}/{document=**} {
      allow write: if request.auth != null && 
                      request.auth.uid == userId;
      allow read: if true;
    }
  }
}
